<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Preferences only; the index is derived and is rebuilt on first launch. -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
